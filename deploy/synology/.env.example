# 修改成群晖的固定局域网 IP，不要填写电脑 IP，也不要带 https://。
NAS_IP=192.168.1.10
HTTP_PORT=18080
HTTPS_PORT=8443
BINGJIAN_IMAGE=ghcr.io/nieten/jianfei-api:latest
# 默认对外地址为 http://NAS_IP:HTTP_PORT。需要 HTTPS 配对信息时填写完整 HTTPS 地址。
BINGJIAN_PUBLIC_URL=

# 建议填写至少 10 位独立密码并另行保存，启用每日加密备份。
BACKUP_PASSWORD=
BACKUP_HOUR=3

# AI 可以稍后在 App 中配置，下列项可以留空。
AI_PROTOCOL=responses
AI_URL=
AI_KEY=
AI_MODEL=
AI_EXTERNAL=true
AI_ALLOWED_HOSTS=
FOOD_API_KEY=

# 可选推送私钥放在 secrets 目录。
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.bingjian.health
APNS_SANDBOX=true
