{
    # 直接访问内网 IP 时，客户端可能不发送 SNI。
    default_sni {$SERVER_NAME:localhost}
}

{$SERVER_NAME:localhost}:443 {
    tls internal
    encode zstd gzip
    request_body {
        max_size 4GB
    }
    reverse_proxy api:8000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
