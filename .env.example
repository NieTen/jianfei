# 请填写实际内网地址。Caddy 为此地址签发内网证书。
SERVER_NAME=192.168.1.10
LAN_BIND=192.168.1.10
HTTPS_PORT=8443
PUBLIC_URL=https://192.168.1.10:8443

# 默认 private 保留已有 NAS 功能；官方云使用 cloud，PUBLIC_URL 须为 HTTPS。
# cloud 初始所有用户均为基础账号，AI 配置及 SVIP 仅由受限 CLI 管理。
DEPLOYMENT_MODE=private
AI_DAILY_LIMIT=30
EMAIL_CODE_TTL_SECONDS=600
# 云端注册/找回需要邮件服务；验证码仅发邮件，不写日志或 API 响应。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# 兼容旧配置，此值不再用于注册，可留空。
BOOTSTRAP_CODE=

# 至少 10 位，配置后每日自动备份并执行恢复校验。
BACKUP_PASSWORD=
BACKUP_HOUR=3

# 以下 AI_* 默认接口仅用于 private 模式，可在 App 设置个人接口。
# cloud 模式忽略个人/默认接口，使用受限 ai-configure CLI 配置的平台模型和密钥。
# 默认使用 Responses API，填写 /v1 根地址或完整 /responses 地址。
AI_URL=
AI_PROTOCOL=responses
AI_MODEL=
AI_KEY=
AI_EXTERNAL=true
# App 设置中需要使用内网 AI 网关时，在这里填写允许的主机名或 IP，逗号分隔。
AI_ALLOWED_HOSTS=

# 可选 USDA FoodData Central 查询密钥。
FOOD_API_KEY=

# 可选 Apple 远程推送配置，私钥文件放到本地 secrets 目录。
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.bingjian.health
APNS_SANDBOX=true
